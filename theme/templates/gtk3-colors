# target: ~/.config/gtk-3.0/gtk.css
/* generated by theme/apply.py - do not edit. Wallpaper palette over Adwaita-dark. */
window, .background, dialog { background-color: {bg}; color: {fg}; }
headerbar, .titlebar, toolbar, .toolbar, menubar { background-image: none; background-color: {crust}; color: {fg}; border-color: {surface}; box-shadow: none; }
.view, iconview, treeview.view, textview text, placessidebar, placessidebar list, .sidebar, scrolledwindow { background-color: {mantle}; color: {fg}; }
.view:selected, iconview:selected, treeview.view:selected, row:selected, placessidebar row:selected, .sidebar row:selected, selection, entry selection {
    background-image: none; background-color: {accent}; color: {crust}; border-radius: 10px; }
.view:selected:backdrop, row:selected:backdrop, iconview:selected:backdrop { background-color: {surface1}; color: {fg}; }
placessidebar row { border-radius: 10px; margin: 1px 6px; }
row:hover, iconview:hover { background-color: {surface}; border-radius: 10px; }
button { border-radius: 10px; background-image: none; background-color: {surface}; color: {fg}; border-color: {surface1}; box-shadow: none; }
button:hover { background-color: {surface1}; }
button.suggested-action, button:checked { background-color: {accent}; color: {crust}; }
entry { border-radius: 10px; background-image: none; background-color: {surface}; color: {fg}; border-color: {surface1}; }
entry:focus { border-color: {accent}; }
statusbar, .statusbar { background-color: {crust}; color: {subtext}; }
menu, .menu, .context-menu, popover, popover.background { background-color: {surface}; color: {fg}; border-radius: 12px; }
menuitem:hover { background-color: {accent}; color: {crust}; }
scrollbar slider { background-color: {surface1}; border-radius: 8px; }
scrollbar slider:hover { background-color: {accent}; }
