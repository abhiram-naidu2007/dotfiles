# target: ~/.local/share/thorium-ext/rice-newtab/newtab.css
/* generated by theme/apply.py - do not edit. bg.jpg is the desktop wallpaper (copied by `rice`). */
:root { --ink: {fg}; --soft: {subtext}; --faint: {dim}; --base: {crust}; --card: rgba({surface_rgb}, 0.72);
  --line: rgba({surface2_rgb}, 0.8); --a: {accent}; --b: {accent2}; --veil: rgba({crust_rgb}, 0.62); }
html, body { height: 100%; margin: 0; overflow: hidden; }
body { color: var(--ink); font-family: Inter, sans-serif; background: var(--base); }
#bg { position: fixed; inset: -60px; background: url(bg.jpg) center / cover; filter: blur(26px) saturate(1.15); }
#bg::after { content: ""; position: absolute; inset: 0; background: var(--veil); }
#curve { position: fixed; inset: 0; width: 100%; height: 100%; opacity: 0.55; }
main { position: relative; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding-bottom: 6vh; box-sizing: border-box; }
#clock { font: 200 112px/1 "Inter Display", Inter, sans-serif; letter-spacing: -3px; font-variant-numeric: tabular-nums; }
#date { font-size: 17px; color: var(--soft); margin-bottom: 26px; }
#q { width: min(620px, 80vw); box-sizing: border-box; padding: 15px 26px; font: 16px Inter, sans-serif; color: var(--ink);
  background: var(--card); border: 1px solid var(--line); border-radius: 999px; outline: none; backdrop-filter: blur(12px);
  transition: border-color .15s, transform .2s cubic-bezier(.34, 1.56, .64, 1); }
#q:focus { border-color: var(--a); transform: scale(1.025); }
#q::placeholder { color: var(--faint); }
#links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 30px; max-width: 860px; }
#links a { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 92px; padding: 14px 6px 10px; border-radius: 18px;
  color: var(--soft); text-decoration: none; font-size: 12px; background: var(--card); border: 1px solid transparent;
  backdrop-filter: blur(12px); transition: transform .2s cubic-bezier(.34, 1.56, .64, 1), border-color .15s, color .15s; }
#links a:hover { transform: translateY(-5px); border-color: var(--a); color: var(--ink); }
#links img { width: 28px; height: 28px; border-radius: 7px; }
#links span { max-width: 84px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
aside { position: fixed; bottom: 30px; cursor: pointer; user-select: none; }
#wild { left: 36px; display: flex; align-items: flex-end; gap: 14px; }
#sprite { image-rendering: pixelated; animation: bob 2.6s ease-in-out infinite; }
#wild.hop #sprite { animation: hop .4s ease-out; }
#wildname { margin: 0 0 8px; font-size: 14px; color: var(--soft); }
#wildname b { color: var(--a); }
#math { right: 40px; text-align: right; }
#formula { margin: 0; font: 600 19px Inter, sans-serif; }
#who { margin: 4px 0 0; font-size: 13px; font-style: italic; color: var(--faint); }
@keyframes bob { 50% { transform: translateY(-7px); } }
@keyframes hop { 40% { transform: translateY(-26px) scale(1.06); } }
@media (prefers-reduced-motion: reduce) { #sprite { animation: none; } #curve { display: none; } }
