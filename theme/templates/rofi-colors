# target: ~/.config/rofi/colors.rasi
/* generated by theme/apply.py - do not edit */
* {
    bg:       #{crust_hex}{glass};
    bg-solid: {crust};
    mantle:   {mantle};
    base:     {bg};
    surface:  {surface};
    surface1: {surface1};
    surface2: {surface2};
    fg:       {fg};
    subtext:  {subtext};
    dim:      {dim};
    accent:   {accent};
    accent2:  {accent2};
    ok:       {ok};
    warn:     {warn};
    crit:     {crit};
    grad-select: linear-gradient(to right, {accent}, {accent2});
    grad-input:  linear-gradient(to right, {surface}, {surface1});
    /* fades the bottom of the art panel so the caption stays readable */
    veil: linear-gradient(to bottom, #{crust_hex}00, #{crust_hex}e6);
}
