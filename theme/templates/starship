# target: ~/.config/starship.toml
# generated by theme/apply.py - do not edit
add_newline = true
format = "$directory$git_branch$git_status$python$nodejs$rust$cmd_duration$line_break$character"
[directory]
style = "bold {accent}"
format = "[$path]($style)[$read_only]($read_only_style) "
truncation_length = 3
truncation_symbol = "…/"
read_only = " 󰌾"
[git_branch]
format = "[on]({dim}) [ $branch]($style) "
style = "{accent2}"
[git_status]
format = "[$all_status$ahead_behind]($style)"
style = "{yellow}"
[python]
format = "[ $virtualenv]($style) "
style = "{yellow}"
detect_extensions = []
[nodejs]
format = "[ $version]($style) "
style = "{green}"
[rust]
format = "[ $version]($style) "
style = "{red}"
[cmd_duration]
format = "[took $duration]($style) "
style = "{dim}"
min_time = 2000
[character]
success_symbol = "[❯]({accent})"
error_symbol = "[❯]({crit})"
vimcmd_symbol = "[❮]({accent2})"
