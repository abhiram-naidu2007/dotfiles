# target: ~/.config/starship.toml
# generated by theme/apply.py - do not edit
add_newline = false
format = "$directory$git_branch$git_status$cmd_duration$character"
[directory]
style = "bold {accent}"
truncation_length = 3
[git_branch]
format = "[ $branch]($style) "
style = "{ok}"
[git_status]
format = "[$all_status$ahead_behind]($style)"
style = "{warn}"
[cmd_duration]
format = "[ $duration]($style) "
style = "{dim}"
min_time = 2000
[character]
success_symbol = "[❯]({accent})"
error_symbol = "[❯]({crit})"
