# target: ~/.config/zathura/colors
# generated by theme/apply.py - do not edit
set default-bg                  "{crust}"
set default-fg                  "{fg}"
set statusbar-bg                "{crust}"
set statusbar-fg                "{subtext}"
set inputbar-bg                 "{surface}"
set inputbar-fg                 "{fg}"
set notification-bg             "{surface}"
set notification-fg             "{fg}"
set notification-error-bg       "{crit}"
set notification-error-fg       "{crust}"
set notification-warning-bg     "{warn}"
set notification-warning-fg     "{crust}"
set highlight-color             "rgba({accent_rgb}, 0.40)"
set highlight-active-color      "rgba({accent2_rgb}, 0.55)"
set highlight-fg                "{fg}"
set completion-bg               "{surface}"
set completion-fg               "{fg}"
set completion-group-bg         "{surface}"
set completion-group-fg         "{accent}"
set completion-highlight-bg     "{accent}"
set completion-highlight-fg     "{crust}"
set index-bg                    "{bg}"
set index-fg                    "{fg}"
set index-active-bg             "{surface1}"
set index-active-fg             "{accent}"
set render-loading-bg           "{bg}"
set render-loading-fg           "{dim}"
# the page itself: paper = bg, ink = fg
set recolor-lightcolor          "{bg}"
set recolor-darkcolor           "{fg}"
