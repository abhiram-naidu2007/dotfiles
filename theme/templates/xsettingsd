# target: ~/.config/xsettingsd/xsettingsd.conf
# generated by theme/apply.py - do not edit. Tells running GTK apps the theme changed (pkill -HUP xsettingsd).
Net/ThemeName "{gtk_theme}"
Net/IconThemeName "{icon_theme}"
Gtk/ApplicationPreferDarkTheme {prefer_dark}
Gtk/CursorThemeName "catppuccin-mocha-peach-cursors"
Gtk/CursorThemeSize 24
Gtk/FontName "Inter 10"
