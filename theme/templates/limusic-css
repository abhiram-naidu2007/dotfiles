# target: ~/.config/limusic-rice/rice.css
/* generated by theme/apply.py. limusic/rice.so injects it into limusic's own page (html[data-rice]). */
html[data-rice] {
  --background: #{crust_hex}{glass} !important;
  --foreground: {fg} !important;
  --card: #{mantle_hex}{glass} !important;
  --card-foreground: {fg} !important;
  --popover: {mantle} !important;
  --popover-foreground: {fg} !important;
  --primary: {accent} !important;
  --primary-foreground: {crust} !important;
  --secondary: {surface} !important;
  --secondary-foreground: {fg} !important;
  --muted: {surface} !important;
  --muted-foreground: {dim} !important;
  --accent: {accent} !important;
  --accent-foreground: {crust} !important;
  --destructive: {crit} !important;
  --border: {surface1} !important;
  --input: {surface1} !important;
  --ring: {accent} !important;
  --sidebar: #{mantle_hex}{glass} !important;
  --sidebar-foreground: {fg} !important;
  --sidebar-primary: {accent} !important;
  --sidebar-primary-foreground: {crust} !important;
  --sidebar-accent: {surface} !important;
  --sidebar-accent-foreground: {fg} !important;
  --sidebar-border: {surface1} !important;
  --sidebar-ring: {accent} !important;
  --chart-1: {accent} !important;
  --chart-2: {accent2} !important;
  --chart-3: {blue} !important;
  --chart-4: {magenta} !important;
  --chart-5: {cyan} !important;
  --radius: 12px !important;
  --font-sans: "Inter", sans-serif !important;
  --default-font-family: "Inter", sans-serif !important;
  --font-heading: "Inter Display", "Inter", sans-serif !important;
  --font-mono: "JetBrainsMono Nerd Font", monospace !important;
  --rice-grad: linear-gradient(to right, {accent}, {accent2});
  font-feature-settings: "cv11", "ss01";
}
html[data-rice] ::selection { background: {accent}; color: {crust}; }

/* i3 places the window: no minimise or maximise */
html[data-rice] header [aria-label="Minimize"],
html[data-rice] header [aria-label="Maximize"] { display: none !important; }
html[data-rice] header[data-tauri-drag-region] { background: transparent !important; border-color: transparent !important; }

/* headings and numbers */
html[data-rice] h1, html[data-rice] h2, html[data-rice] .font-heading { letter-spacing: -0.02em; }
html[data-rice] .tabular-nums { font-family: var(--font-mono); font-size: 11px; }

/* the album-art wash fades out instead of ending on an edge over the glass */
html[data-rice] .art-wash { -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent); mask-image: linear-gradient(to bottom, #000 35%, transparent); }

/* the play button and selected chips: the launcher's gradient */
html[data-rice] footer button[aria-label="Play"], html[data-rice] footer button[aria-label="Pause"] {
  background: var(--rice-grad) !important; color: {crust} !important; box-shadow: 0 4px 14px -4px {accent};
}
html[data-rice] .bg-primary { background-image: var(--rice-grad); }

/* seek and volume: gradient fill, a small knob always visible */
html[data-rice] input[type="range"].range::-webkit-slider-runnable-track {
  background: linear-gradient(to right, {accent}, {accent2}) 0 0 / var(--pct, 0%) 100% no-repeat, {surface1};
  height: 4px;
}
html[data-rice] input[type="range"].range::-webkit-slider-thumb { opacity: 1; background: {fg}; transform: scale(0.75); }
html[data-rice] input[type="range"].range:hover::-webkit-slider-thumb { transform: scale(1.1); }

/* the player bar floats */
html[data-rice] footer { margin: 0 10px 10px; border: 1px solid {surface1} !important; border-radius: 14px; }
html[data-rice] footer img { border-radius: 10px !important; box-shadow: 0 6px 18px -8px #000; }

/* cards and pictures: rounder, lift on hover */
html[data-rice] main img { border-radius: 10px; }
html[data-rice] main a, html[data-rice] main [role="button"] { transition: transform .18s cubic-bezier(.22,1,.36,1), background-color .15s; }
html[data-rice] main a:hover img { transform: scale(1.03); transition: transform .25s cubic-bezier(.22,1,.36,1); }

html[data-rice] ::-webkit-scrollbar { width: 6px; height: 6px; }
html[data-rice] ::-webkit-scrollbar-thumb { background: {surface2} !important; }
html[data-rice] :focus-visible { outline: 2px solid {accent} !important; outline-offset: 2px; }
