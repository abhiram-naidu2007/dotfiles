#!/bin/bash
# rice-preview PATH: what `ev` (fzf) shows beside the highlighted file.
f=$1
[ -e "$f" ] || { echo "gone: $f"; exit; }
if [ -d "$f" ]; then
  exec eza --tree --level=2 --icons --color=always --group-directories-first "$f"
fi
case "$(file -Lb --mime-type "$f")" in
  image/*)         exec chafa -f symbols -s "${FZF_PREVIEW_COLUMNS:-60}x${FZF_PREVIEW_LINES:-30}" "$f" ;;
  application/pdf) pdftotext -l 2 -layout "$f" - 2>/dev/null | head -n 80 ;;
  text/*|application/json|application/x-shellscript|application/javascript|application/toml|inode/x-empty)
                   exec batcat --color=always --style=numbers --line-range=:200 "$f" ;;
  *)               file -Lb "$f"; ls -lh "$f" ;;
esac
