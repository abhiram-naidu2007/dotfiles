/* Base look for every rofi menu (power, display, keys, kaomoji ...).
   The launcher (launcher.rasi) and the wallpaper grid (grid.rasi) build on it.
   Colours: colors.rasi, generated by ~/dotfiles/theme/apply.py. */
configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "󰀻";
    display-run: "";
    display-window: "󰖯";
    drun-display-format: "{name}";
    window-format: "{c}  {t}";
    font: "Inter Medium 11";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    highlight: bold;
}
window {
    width: 36em;
    border: 1px;
    border-color: @surface2;
    border-radius: 18px;
    background-color: @bg;
    location: center;
}
mainbox { padding: 14px; spacing: 12px; border: 0; children: [ inputbar, message, listview ]; }

inputbar {
    padding: 11px 16px;
    spacing: 12px;
    border-radius: 12px;
    background-color: @surface;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; font: "JetBrainsMono Nerd Font 13"; vertical-align: 0.5; }
entry {
    text-color: @fg;
    placeholder: "type to search";
    placeholder-color: @dim;
    cursor-color: @accent;
    cursor-width: 2px;
    vertical-align: 0.5;
}

message { padding: 0 6px; border: 0; }
textbox { text-color: @dim; font: "Inter 9"; }

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
    border: 0;
}
element {
    padding: 9px 12px;
    spacing: 12px;
    border-radius: 12px;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element normal.active, element alternate.active { background-color: transparent; text-color: @accent2; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @crit; }
element selected.normal, element selected.active {
    background-image: @grad-select;
    text-color: @bg-solid;
}
element selected.urgent { background-color: @crit; text-color: @bg-solid; }
element-icon { size: 1.5em; vertical-align: 0.5; }
element-text { text-color: inherit; vertical-align: 0.5; }
