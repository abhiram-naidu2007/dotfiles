# Colours: dunstrc.d/10-colors.conf (generated by ~/dotfiles/theme/apply.py)
# Any app that sends a desktop notification (notify-send, Thorium, nm-applet,
# blueman, i3 scripts ...) shows up here; no per-app setup needed.
[global]
    monitor = 0
    follow = mouse
    width = (260, 380)
    origin = bottom-right
    offset = (18, 18)
    gap_size = 8
    corner_radius = 12
    frame_width = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    font = Inter 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ellipsize = end
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_theme = elementary-xfce-dark
    enable_recursive_icon_lookup = true
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 5
    progress_bar_min_width = 160
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    sort = yes
    idle_threshold = 120
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    dmenu = rofi -dmenu -p dunst

# Volume / brightness popups from i3/scripts/osd.sh
[osd]
    appname = osd
    timeout = 1.5
    format = "%s  <b>%b</b>"
    history_ignore = yes
