# Colours: dunstrc.d/10-colors.conf (generated by ~/dotfiles/theme/apply.py)
[global]
    monitor = 0
    follow = mouse
    width = (200, 360)
    origin = bottom-right
    offset = (16, 16)
    corner_radius = 10
    frame_width = 2
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    font = Inter 10
    format = "<b>%s</b>\n%b"
    icon_theme = elementary-xfce-dark
    enable_recursive_icon_lookup = true
    icon_position = left
    max_icon_size = 48
    timeout = 5
    mouse_left_click = close_current
