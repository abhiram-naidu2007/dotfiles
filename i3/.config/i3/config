# i3 config. Reload: Super+Shift+C   Restart: Super+Shift+R   Keys list: Super+/
# Lines ending in "## text" appear in the Super+/ cheat sheet.
# Colours come from colors.conf (generated by ~/dotfiles/theme/apply.py).

set $mod Mod4
font pango:JetBrainsMono Nerd Font 10
floating_modifier $mod
include ~/.config/i3/colors.conf

# --- look ---
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 6
gaps outer 2
focus_follows_mouse no

# --- apps ---
bindsym $mod+Return exec ghostty                      ## terminal
bindsym $mod+KP_Enter exec ghostty
bindsym Control+Mod1+t exec ghostty                   ## terminal (Ctrl+Alt+T)
bindsym $mod+a exec rofi -show drun                   ## app launcher
bindsym $mod+space exec rofi -show drun               ## app launcher
bindsym $mod+Tab exec rofi -show window               ## window switcher
bindsym $mod+b exec exo-open --launch WebBrowser      ## browser
bindsym $mod+e exec exo-open --launch FileManager     ## file manager
bindsym $mod+Escape exec ~/.config/i3/scripts/powermenu.sh  ## power menu
bindsym $mod+g exec ~/dotfiles/lockscreen/lock.sh     ## lock screen
bindsym $mod+slash exec ~/.config/i3/scripts/cheatsheet.sh  ## this key list
bindsym Print exec ~/.config/i3/scripts/screenshot.sh full  ## screenshot (screen)
bindsym $mod+Shift+s exec ~/.config/i3/scripts/screenshot.sh area  ## screenshot (area)

# --- windows ---
bindsym $mod+q kill                                   ## close window
bindsym $mod+f fullscreen toggle                      ## fullscreen
bindsym $mod+Shift+space floating toggle              ## float / tile
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left                          ## focus (arrows or h j k l)
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left                     ## move window (Shift + arrows or h j k l)
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+v split v                                ## next window below (manual split)
bindsym $mod+Shift+v split h                          ## next window beside (manual split)
bindsym $mod+w layout tabbed                          ## tabbed layout
bindsym $mod+s layout toggle split                    ## split layout
mode "resize" {
    bindsym h resize shrink width 40 px
    bindsym l resize grow width 40 px
    bindsym k resize shrink height 40 px
    bindsym j resize grow height 40 px
    bindsym Left resize shrink width 40 px
    bindsym Right resize grow width 40 px
    bindsym Up resize shrink height 40 px
    bindsym Down resize grow height 40 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"                          ## resize mode (h j k l, Esc to leave)

# --- workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+1 workspace number $ws1                  ## go to workspace 1-10
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Shift+1 move container to workspace number $ws1  ## send window to workspace 1-10
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- session ---
bindsym $mod+Shift+c reload                           ## reload i3 config
bindsym $mod+Shift+r restart                          ## restart i3 (keeps windows)
bindsym $mod+Shift+e exec ~/.config/i3/scripts/powermenu.sh  ## exit menu

# --- media keys ---
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# --- floating rules (dialogs, pickers) ---
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Xfce4-appearance-settings|Xfce4-settings-manager"] floating enable

# --- autostart ---
exec_always --no-startup-id ~/.config/i3/scripts/autostart.sh
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/dotfiles/lockscreen/lock.sh
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id nm-applet
exec --no-startup-id autotiling
