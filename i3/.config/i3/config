# i3 config. Reload: Super+Shift+C   Restart: Super+Shift+R   Keys list: Super+/
# A "## text" line directly above a bindsym puts it in the Super+/ cheat sheet. (Never put ## after a command: i3 would treat it as part of the command.)
# Colours come from colors.conf (generated by ~/dotfiles/theme/apply.py).

set $mod Mod4
font pango:Inter SemiBold 10
floating_modifier $mod
include ~/.config/i3/colors.conf

# --- look ---
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
# 8 px everywhere: between windows, at screen edges, and around the bar (polybar offset 8)
gaps inner 8
gaps outer 0
# polybar floats (override-redirect): 8 offset + 32 height; i3 adds the inner 8 below it
gaps top 40
title_align center
for_window [all] title_window_icon padding 4px
focus_follows_mouse no

# --- apps ---
## terminal
bindsym $mod+Return exec ghostty
bindsym $mod+KP_Enter exec ghostty
## terminal (Ctrl+Alt+T)
bindsym Control+Mod1+t exec ghostty
## app launcher
bindsym $mod+a exec env XDG_CURRENT_DESKTOP=XFCE rofi -show drun
## app launcher
bindsym $mod+space exec env XDG_CURRENT_DESKTOP=XFCE rofi -show drun
## window switcher
bindsym $mod+Tab exec rofi -show window
## browser (Thorium)
bindsym $mod+b exec thorium-browser --new-window
## browser: choose profile (3 accounts)
bindsym $mod+Shift+b exec ~/.config/i3/scripts/browser.sh
## WhatsApp (ZapFast: open / focus)
bindsym $mod+z exec zapfast
## WhatsApp (ZapFast: quit, not just tray)
bindsym $mod+Shift+z exec zapfast quit
## file manager
bindsym $mod+e exec exo-open --launch FileManager
## quick settings menu
bindsym $mod+i exec ~/.config/i3/scripts/settings.sh

## power menu
bindsym $mod+Escape exec ~/.config/i3/scripts/powermenu.sh
## lock screen
bindsym $mod+g exec ~/dotfiles/lockscreen/lock.sh
## display menu (mirror / extend / monitor / laptop)
bindsym $mod+p exec ~/.config/i3/scripts/display.sh menu
## display: mirror
bindsym $mod+Control+m exec ~/.config/i3/scripts/display.sh mirror
## display: extend
bindsym $mod+Control+e exec ~/.config/i3/scripts/display.sh extend
## display: external monitor only
bindsym $mod+Control+o exec ~/.config/i3/scripts/display.sh monitor
## display: laptop only
bindsym $mod+Control+l exec ~/.config/i3/scripts/display.sh laptop
## this key list
bindsym $mod+slash exec ~/.config/i3/scripts/cheatsheet.sh
## screenshot (screen)
bindsym Print exec ~/.config/i3/scripts/screenshot.sh full
## screenshot (area)
bindsym $mod+Shift+s exec ~/.config/i3/scripts/screenshot.sh area

# --- windows ---
## workspace 3 showcase (Super+Shift+W = open / again to close)
bindsym $mod+Shift+w exec ~/.config/i3/scripts/showcase.sh

## close window
bindsym $mod+q kill
## fullscreen
bindsym $mod+f fullscreen toggle
## float / tile
bindsym $mod+Shift+space floating toggle
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
## focus (arrows or h j k l)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
## move window (Shift + arrows or h j k l)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
## next window below (manual split)
bindsym $mod+v split v
## next window beside (manual split)
bindsym $mod+Shift+v split h
## tabbed layout
bindsym $mod+w layout tabbed
## split layout
bindsym $mod+s layout toggle split
mode "resize" {
    bindsym h resize shrink width 40 px
    bindsym l resize grow width 40 px
    bindsym k resize shrink height 40 px
    bindsym j resize grow height 40 px
    bindsym Left resize shrink width 40 px
    bindsym Right resize grow width 40 px
    bindsym Up resize shrink height 40 px
    bindsym Down resize grow height 40 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
## resize mode (h j k l, Esc to leave)
bindsym $mod+r mode "resize"

# --- workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
## go to workspace 1-10
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
## next workspace
bindsym $mod+Ctrl+Right workspace next
## previous workspace
bindsym $mod+Ctrl+Left workspace prev
## send window to workspace 1-10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- session ---
## reload i3 config
bindsym $mod+Shift+c reload
## restart i3 (keeps windows)
bindsym $mod+Shift+r restart
## exit menu
bindsym $mod+Shift+e exec ~/.config/i3/scripts/powermenu.sh

# --- media keys (osd.sh = change + on-screen popup) ---
## volume up / down / mute (media keys)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/osd.sh vol up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/osd.sh vol down
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/osd.sh vol mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.config/i3/scripts/osd.sh mic
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/osd.sh bri up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/osd.sh bri down
## play / pause (media keys)
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
## volume / brightness without Fn keys
bindsym $mod+F11 exec --no-startup-id ~/.config/i3/scripts/osd.sh vol down
bindsym $mod+F12 exec --no-startup-id ~/.config/i3/scripts/osd.sh vol up
bindsym $mod+F5 exec --no-startup-id ~/.config/i3/scripts/osd.sh bri down
bindsym $mod+F6 exec --no-startup-id ~/.config/i3/scripts/osd.sh bri up

# --- limusic: scratchpad toggle + direct MPRIS control (launched on demand) ---
for_window [class="(?i)limusic"] floating enable, resize set 1100 700, move position center, move scratchpad
## music: show / hide limusic
bindsym $mod+m exec --no-startup-id ~/.config/i3/scripts/limusic-toggle.sh
## music: previous / play-pause / next (F8 F9 F10)
bindsym $mod+F8 exec --no-startup-id playerctl -p limusic previous
bindsym $mod+F9 exec --no-startup-id playerctl -p limusic play-pause
bindsym $mod+F10 exec --no-startup-id playerctl -p limusic next

# --- floating rules (dialogs, pickers) ---
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Xfce4-appearance-settings|Xfce4-settings-manager"] floating enable

# --- autostart ---
# Mirror to external monitor once at login (exec, not exec_always: a reload must not undo Super+Ctrl+E)
exec --no-startup-id ~/.config/i3/scripts/display.sh auto
exec_always --no-startup-id ~/.config/i3/scripts/autostart.sh
# Wallpaper + colours once per login; the systemd timer swaps them at 06:00 / 18:00
exec --no-startup-id ~/dotfiles/wallpaper/wallpaper.sh
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/dotfiles/lockscreen/lock.sh
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id nm-applet
