# zathura: the PDF reader. Colours: ./colors (generated by ~/dotfiles/theme/apply.py).
# Pages are recoloured to the palette (paper = background, ink = text), so a PDF
# looks like the rest of the desktop; in `rice mode paper` it reads like a book.
include colors

set recolor                 true
set recolor-keephue         true      # figures keep their hues
set recolor-reverse-video   true      # photos and scanned figures keep their own colours
set selection-clipboard     clipboard # mouse selection goes to Ctrl+V
set selection-notification  false
set adjust-open             best-fit  # open with the whole page in view; s = fit width, a = whole page
set guioptions              "s"       # status bar: file name and page; Ctrl+N hides it
set font                    "Inter 10"
set page-v-padding          8
set page-h-padding          8
set scroll-step             80
set scroll-page-aware       true
set incremental-search      true
set window-title-basename   true
set statusbar-home-tilde    true
set statusbar-h-padding     12
set statusbar-v-padding     6
set database                sqlite    # remembers the page of every file

# F1 lists every key (keys.sh). The defaults stay: j k h l, J K page, gg G, / search,
# f follow link, Tab index, a s fit page/width. The mouse works too: wheel scrolls,
# Ctrl+wheel zooms, dragging selects text and copies it, links are clickable.
# (zathura starts the command without a shell, so "~" must be expanded by sh)
map <F1>    exec "sh -c ~/.config/zathura/keys.sh"
map [fullscreen] <F1> exec "sh -c ~/.config/zathura/keys.sh"
map i       recolor                   # palette colours <-> the document's own
# page colours, whatever the desktop mood: Alt+1 desktop palette, Alt+2 paper, Alt+3 night, Alt+4 the document's own
map <A-1>   exec "sh -c '~/.config/zathura/scheme.sh $DBUS desktop'"
map <A-2>   exec "sh -c '~/.config/zathura/scheme.sh $DBUS paper'"
map <A-3>   exec "sh -c '~/.config/zathura/scheme.sh $DBUS night'"
map <A-4>   exec "sh -c '~/.config/zathura/scheme.sh $DBUS own'"
map u       scroll half-up
map d       scroll half-down
map D       toggle_page_mode          # one page <-> two side by side
map r       reload
map R       rotate
map p       print
map <C-n>   toggle_statusbar
map <C-=>   zoom in
map <C-->   zoom out
map <C-0>   adjust_window width
map [fullscreen] i recolor
map [fullscreen] u scroll half-up
map [fullscreen] d scroll half-down
