# zathura: the PDF reader. Colours: ./colors (generated by ~/dotfiles/theme/apply.py).
# Pages are recoloured to the palette (paper = background, ink = text), so a PDF
# looks like the rest of the desktop; in `rice mode paper` it reads like a book.
include colors

set recolor                 true
set recolor-keephue         true      # figures keep their hues
set selection-clipboard     clipboard # mouse selection goes to Ctrl+V
set selection-notification  false
set adjust-open             width
set guioptions              ""        # no bars; Ctrl+N shows the status bar
set font                    "Inter 10"
set page-v-padding          8
set page-h-padding          8
set scroll-step             80
set scroll-page-aware       true
set incremental-search      true
set window-title-basename   true
set statusbar-home-tilde    true
set statusbar-h-padding     12
set statusbar-v-padding     6
set database                sqlite    # remembers the page of every file

# LaTeX / Typst: Ctrl+click jumps to the source line in a running nvim
set synctex                 true
set synctex-editor-command  "nvim --headless -c \"VimtexInverseSearch %{line} '%{input}'\""

# keys (the defaults stay: j k h l, J K page, gg G, / search, f follow link, Tab index, a s fit page/width)
map i       recolor                   # palette colours <-> the document's own
map u       scroll half-up
map d       scroll half-down
map D       toggle_page_mode          # one page <-> two side by side
map r       reload
map R       rotate
map p       print
map <C-n>   toggle_statusbar
map <C-=>   zoom in
map <C-->   zoom out
map <C-0>   adjust_window width
map [fullscreen] i recolor
map [fullscreen] u scroll half-up
map [fullscreen] d scroll half-down
