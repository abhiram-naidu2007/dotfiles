#!/bin/bash
args=()
for a in "$@"; do
  case "$a" in -j|--json|-r|--batch) ;; *) args+=("$a") ;; esac
done
set -- "${args[@]}"

focused() { i3-msg -t get_tree | jq -c '[recurse(.nodes[]?, .floating_nodes[]?) | select(.focused == true)][0]'; }

monitors() {
  local foc
  foc=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused) | .output')
  xrandr --query | awk -v foc="$foc" -v all="$1" '
    function flush() {
      if (name == "") return
      if (!on && all != "all") { name = ""; return }
      if (n++) printf ","
      printf "{\"id\":%d,\"name\":\"%s\",\"description\":\"%s\",\"width\":%d,\"height\":%d,\"refreshRate\":%s,\"x\":%d,\"y\":%d,\"scale\":1.0,\"transform\":0,\"vrr\":false,\"focused\":%s,\"disabled\":%s,\"availableModes\":[%s]}", n - 1, name, name, w, h, rr == "" ? 0 : rr, x, y, (name == foc ? "true" : "false"), (on ? "false" : "true"), modes
      name = ""
    }
    BEGIN { printf "["; n = 0 }
    / connected/ {
      flush(); name = $1; on = 0; modes = ""; w = h = x = y = 0; rr = ""
      for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) { split($i, g, /[x+]/); w = g[1]; h = g[2]; x = g[3]; y = g[4]; on = 1 }
      next
    }
    / disconnected/ { flush(); next }
    /^   [0-9]+x[0-9]+/ && name != "" {
      split($1, d, "x")
      for (i = 2; i <= NF; i++) {
        r = $i; cur = (r ~ /\*/); gsub(/[*+]/, "", r); if (r == "") continue
        if (cur) rr = r
        if ((name, $1, r) in seen) continue
        seen[name, $1, r] = 1
        modes = modes (modes == "" ? "" : ",") "\"" $1 "@" r "Hz\""
      }
    }
    END { flush(); print "]" }'
}

case "$1" in
  activewindow)
    focused | jq -c 'if .window then {address: ("0x" + (.window | tostring)), class: (.window_properties.class // ""), initialClass: (.window_properties.instance // .window_properties.class // ""), title: .name, initialTitle: .name, fullscreen: (if .fullscreen_mode == 1 then 2 else 0 end), floating: (.type == "floating_con"), at: [.rect.x, .rect.y], size: [.rect.width, .rect.height], pid: -1} else {} end' ;;
  monitors) monitors "$2" ;;
  cursorpos)
    eval "$(xdotool getmouselocation --shell)"; printf '{"x":%d,"y":%d}\n' "$X" "$Y" ;;
  devices)
    l=$(setxkbmap -query | awk '/layout/{print $2}' | cut -d, -f1)
    xinput list --name-only | jq -R . | jq -sc --arg l "$l" '{mice: [.[] | select(test("touchpad|mouse|synaptics|trackpad"; "i")) | {name: .}], keyboards: [{name: "keyboard", main: true, active_keymap: ($l | if . == "us" then "English (US)" else . end)}]}' ;;
  switchxkblayout)
    cur=$(setxkbmap -query | awk '/layout/{print $2}'); IFS=, read -ra L <<< "$cur"
    [ ${#L[@]} -gt 1 ] && setxkbmap -layout "$(IFS=,; echo "${L[*]:1},${L[0]}")"; echo ok ;;
  dispatch)
    case "$2" in
      killactive|hl.dsp.window.close*) i3-msg -q kill; echo ok ;;
      exit|hl.dsp.exit*) i3-msg -q exit; echo ok ;;
      workspace) i3-msg -q "workspace number $3"; echo ok ;;
      exec) shift 2; i3-msg -q "exec --no-startup-id $*"; echo ok ;;
      *) echo "unsupported on i3: dispatch $2" >&2; exit 1 ;;
    esac ;;
  keyword)
    case "$2" in
      monitor)
        IFS=, read -r out mode pos scale _ rot _ _ <<< "$3"
        res=${mode%@*}; rate=${mode#*@}
        case "$rot" in 1) r=left ;; 2) r=inverted ;; 3) r=right ;; *) r=normal ;; esac
        cur=$(xrandr --query | awk -v o="$out" '$1 == o { f = 1; next } f && /^   / { if ($0 ~ /\*/) { for (i = 2; i <= NF; i++) if ($i ~ /\*/) { r = $i; gsub(/[*+]/, "", r) } print $1 "@" r; exit } } f && !/^   / { exit }')
        cpos=$(xrandr --query | awk -v o="$out" '$1 == o { for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { split($i, g, "+"); print g[2] "x" g[3] } }')
        if [ "$cur" = "$res@$rate" ] && { [ -z "$pos" ] || [ "$pos" = auto ] || [ "$pos" = "$cpos" ]; } && [ "$r" = normal ]; then echo ok; exit 0; fi
        set -- --output "$out" --mode "$res"
        [ "$rate" != "$mode" ] && set -- "$@" --rate "$rate"
        [ -n "$pos" ] && [ "$pos" != auto ] && set -- "$@" --pos "$pos"
        xrandr "$@" --rotate "$r" && echo ok ;;
      input:sensitivity|input:accel_profile)
        xinput list --name-only | grep -iE 'touchpad|mouse' | while IFS= read -r d; do
          if [ "$2" = input:sensitivity ]; then xinput set-prop "$d" "libinput Accel Speed" "$3" 2>/dev/null
          elif [ "$3" = flat ]; then xinput set-prop "$d" "libinput Accel Profile Enabled" 0 1 0 2>/dev/null
          else xinput set-prop "$d" "libinput Accel Profile Enabled" 1 0 0 2>/dev/null; fi
        done; echo ok ;;
      *) echo "unsupported on i3: keyword $2" >&2; exit 1 ;;
    esac ;;
  version) printf '{"tag":"%s"}\n' "$(i3 --version | awk '{print $3}')" ;;
  reload) i3-msg -q reload; echo ok ;;
  *) echo "unsupported on i3: $1" >&2; exit 1 ;;
esac
