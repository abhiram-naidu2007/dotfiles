#!/bin/bash
fn=$1; shift
if pgrep -x loka >/dev/null && "$HOME/.local/bin/loka" msg "$fn" "$@" 2>/dev/null; then
    exit 0
fi
case "$fn" in
    powermenu) exec ~/.config/i3/scripts/powermenu.sh ;;
    clipboard) exec sh -c 'pgrep -x xfce4-clipman >/dev/null || { setsid xfce4-clipman >/dev/null 2>&1 & sleep 0.5; }; xfce4-popup-clipman' ;;
esac
