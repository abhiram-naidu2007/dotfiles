#!/bin/bash
interval=${1:-3}
rc6=$(ls /sys/class/drm/card*/gt/gt0/rc6_residency_ms 2>/dev/null | head -1)
dgpu=""
for d in /sys/bus/pci/devices/*; do
    [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] && [ "$(cat "$d/class" 2>/dev/null | cut -c1-6)" = 0x0300 ] && dgpu=$d && break
done
ctemp=""
for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = coretemp ] && ctemp=$h/temp1_input && break
done
now_ms() { local s; read -r s _ < /proc/uptime; s=${s/./}; echo $((10#$s * 10)); }
read -r _ a b c idle rest < /proc/stat
pt=$((a + b + c + idle)); for x in $rest; do pt=$((pt + x)); done; pi=$idle
pr=$( [ -n "$rc6" ] && cat "$rc6" ); pm=$(now_ms)
while :; do
    sleep "$interval"
    read -r _ a b c idle rest < /proc/stat
    t=$((a + b + c + idle)); for x in $rest; do t=$((t + x)); done
    dt=$((t - pt)); di=$((idle - pi)); pt=$t; pi=$idle
    cpu=0; [ "$dt" -gt 0 ] && cpu=$(( (dt - di) * 100 / dt ))
    while read -r k v _; do
        case $k in MemTotal:) mt=$v ;; MemAvailable:) ma=$v; break ;; esac
    done < /proc/meminfo
    mem=$(( (mt - ma) * 100 / mt ))
    used=$(( (mt - ma) / 1024 ))
    igpu=""
    if [ -n "$rc6" ]; then
        r=$(cat "$rc6"); m=$(now_ms)
        span=$((m - pm)); [ "$span" -gt 0 ] && igpu=$(( 100 - (r - pr) * 100 / span ))
        [ -n "$igpu" ] && { [ "$igpu" -lt 0 ] && igpu=0; [ "$igpu" -gt 100 ] && igpu=100; }
        pr=$r; pm=$m
    fi
    dg="off"
    [ -n "$dgpu" ] && [ "$(cat "$dgpu/power/runtime_status" 2>/dev/null)" = active ] && dg="on"
    temp=""; [ -n "$ctemp" ] && temp=$(( $(cat "$ctemp") / 1000 ))
    echo "$cpu|$mem|$used|$igpu|$dg|$temp"
done
